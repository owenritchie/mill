{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mill",
  "version": "0.1.1",
  "identifier": "com.owenritchie.mill",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "npm run desktop:stage"
  },
  "app": {
    "windows": [
      {
        "title": "Mill",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1A471C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/standalone": "standalone"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
